 lib/pdu.c                      |  12 +++-
 lib/smb2-cmd-close.c           |   8 +++
 lib/smb2-cmd-create.c          |  24 +++++++
 lib/smb2-cmd-echo.c            |   8 +++
 lib/smb2-cmd-error.c           |   4 ++
 lib/smb2-cmd-flush.c           |   7 ++
 lib/smb2-cmd-ioctl.c           |  12 ++++
 lib/smb2-cmd-lock.c            |  12 ++++
