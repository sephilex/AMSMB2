+        if (iov == NULL) {
+                smb2_set_error(smb2, "Failed to add iovector for close reply");
+                return -1;
+        }
 
         smb2_set_uint16(iov, 0, SMB2_CLOSE_REPLY_SIZE);
         smb2_set_uint16(iov, 2, rep->flags);
