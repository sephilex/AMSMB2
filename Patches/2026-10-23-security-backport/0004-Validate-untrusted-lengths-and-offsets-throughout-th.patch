 lib/ntlmssp.c                       | 73 +++++++++++++++++++++++++----
 lib/smb2-cmd-error.c                | 11 +++++
 lib/smb2-cmd-ioctl.c                | 26 ++++++++--
 lib/smb2-cmd-negotiate.c            | 38 +++++++++++----
 lib/smb2-cmd-query-directory.c      | 10 +++-
 lib/smb2-cmd-query-info.c           | 51 ++++++++++++++++++++
 lib/smb2-cmd-read.c                 |  6 ++-
 lib/smb2-cmd-session-setup.c        |  9 +++-
 lib/smb2-data-file-info.c           | 44 +++++++++++++----
