diff --git a/lib/asn1-ber.c b/lib/asn1-ber.c
index 2f461be..550ca00 100644
--- a/lib/asn1-ber.c
+++ b/lib/asn1-ber.c
@@ -165,6 +165,18 @@ int asn1ber_length_from_ber(struct asn1ber_context *actx, uint32_t *len)
         /* simple small len */
         val = (uint32_t)b;
     }
+    /*
+     * A BER length always describes content that follows it in the same
+     * buffer, so it can never exceed what is left. Without this check the
+     * decoded length is handed back to callers (which use it to size the
+     * token they return) while pointing past the end of the input.
+     */
+    if (actx->src_count < actx->src_tail ||
+        val > (uint32_t)(actx->src_count - actx->src_tail))
+    {
+        actx->last_error = -E2BIG;
+        return -1;
+    }
     *len = val;
     return 0;
 }
diff --git a/lib/ntlmssp.c b/lib/ntlmssp.c
index de08f52..e73e65f 100644
--- a/lib/ntlmssp.c
+++ b/lib/ntlmssp.c
@@ -367,7 +367,8 @@ ntlm_decode_challenge_message(struct smb2_context *smb2, struct auth_data *auth_
                 u32 = htole32(outoff);
                 memcpy(&auth_data->ntlm_buf[16], &u32, 4);
 
-                if (inlen > 0 && inlen < len && (outoff + inlen) < alloc_len) {
+                if (inlen > 0 && inoff < len && inlen <= len - inoff && (outoff + inlen) < alloc_len) {
+                        free(auth_data->target_name);
                         auth_data->target_name = discard_const(smb2_utf16_to_utf8((const uint16_t *)(void *)&buf[inoff], inlen / 2));
                         memcpy(&auth_data->ntlm_buf[outoff], &buf[inoff], inlen);
                         outoff += inlen;
@@ -380,18 +381,32 @@ ntlm_decode_challenge_message(struct smb2_context *smb2, struct auth_data *auth_
 
                 infolen = 0;
 
-                if (inlen > 0 && inlen < len && (outoff + inlen) < alloc_len) {
+                /* As for the target name above, the offset has to be validated
+                 * too and not just the length, otherwise the walk below reads
+                 * at an arbitrary offset from the challenge buffer.
+                 */
+                if (inlen > 0 && inoff < len && inlen <= len - inoff &&
+                    (outoff + inlen) < alloc_len) {
                         /* back annotate target info field offset */
                         u32 = htole32(outoff);
                         memcpy(&auth_data->ntlm_buf[44], &u32, 4);
 
                         /* transcode target info fields, appending our target-name */
                         while (inlen > 0) {
+                                /* Each attribute is a 4 byte header followed
+                                 * by attr_len bytes of value, all of which
+                                 * must fit in what is left of the input, and
+                                 * the re-encoded copy must fit in the output.
+                                 */
+                                if (inlen < 4) {
+                                        break;
+                                }
                                 memcpy(&u16, &buf[inoff], 2);
                                 attr_code = htole16(u16);
                                 memcpy(&u16, &buf[inoff + 2], 2);
                                 attr_len = htole16(u16);
-                                if (attr_len > inlen || (outoff + attr_len) > alloc_len) {
+                                if (attr_len > inlen - 4 ||
+                                    (outoff + 4 + attr_len) > alloc_len) {
                                         /* invalid, must be out of parse? */
                                         break;
                                 }
@@ -403,6 +418,14 @@ ntlm_decode_challenge_message(struct smb2_context *smb2, struct auth_data *auth_
                                                 if (utf16_spn != NULL) {
                                                         attr_code = 0x9; /* target-name code */
                                                         attr_len = utf16_spn->len * 2;
+                                                        /* the target-name we append plus the
+                                                         * 4 byte end-of-list marker below have
+                                                         * to fit in the output buffer too
+                                                         */
+                                                        if ((outoff + 4 + attr_len + 4) > alloc_len) {
+                                                                free(utf16_spn);
+                                                                break;
+                                                        }
                                                         u16 = htole16(attr_code);
                                                         memcpy(&auth_data->ntlm_buf[outoff], &u16, 2);
                                                         u16 = htole16(attr_len);
@@ -415,6 +438,9 @@ ntlm_decode_challenge_message(struct smb2_context *smb2, struct auth_data *auth_
                                                         free(utf16_spn);
                                                 }
                                         }
+                                        if ((outoff + 4) > alloc_len) {
+                                                break;
+                                        }
                                         /* insert original end of list attr */
                                         u16 = 0;
                                         memcpy(&auth_data->ntlm_buf[outoff], &u16, 2);
@@ -652,8 +678,10 @@ encode_ntlm_auth(struct smb2_context *smb2, time_t ti,
                 goto finished;
         }
 
-        /* Must have at least enough bytes for server name offset */
-        if (auth_data->ntlm_len < 47) {
+        /* Must have at least enough bytes for server name offset, which is
+         * the 4 bytes at offset 44, so we need 48 bytes and not 47.
+         */
+        if (auth_data->ntlm_len < 48) {
                 goto finished;
         }
         /* get the server neg flags */
@@ -681,7 +709,7 @@ encode_ntlm_auth(struct smb2_context *smb2, time_t ti,
                         auth_data->client_challenge, 8,
                         (uint8_t*)server_challenge,
                         (uint8_t*)server_name_buf, server_name_len) < 0) {
-                return -1;
+                goto finished;
         }
 
         smb2_hmac_md5(&auth_data->buf[8], (unsigned int)auth_data->len-8,
@@ -992,7 +1020,12 @@ encode_ntlm_challenge(struct smb2_context *smb2, struct auth_data *auth_data)
 
         /* save the target info in auth-data for later */
         auth_data->target_info_len = auth_data->len - target_info_pos;
+        free(auth_data->target_info);
         auth_data->target_info = malloc(auth_data->target_info_len);
+        if (auth_data->target_info == NULL) {
+                auth_data->target_info_len = 0;
+                goto finished;
+        }
         memcpy(auth_data->target_info,
                         auth_data->buf + target_info_pos,
                         auth_data->target_info_len);
@@ -1173,6 +1206,13 @@ ntlmssp_get_utf16_field(uint8_t *input_buf, int input_len, int offset, char **re
         memcpy(&u32, &input_buf[offset + 4], 4);
         field_off = le32toh(u32);
         if (field_len && field_off) {
+                /* Both the offset and the length come straight off the wire
+                 * and must be verified to describe a range inside the blob.
+                 */
+                if (field_off > (uint32_t)input_len ||
+                    field_len > (uint32_t)input_len - field_off) {
+                        return;
+                }
                 *result = (char*)smb2_utf16_to_utf8((uint16_t *)(void *)(input_buf + field_off), field_len / 2);
         }
 }
@@ -1195,7 +1235,11 @@ ntlmssp_authenticate_blob(struct smb2_server *server, struct smb2_context *smb2,
         /* uint32_t negotiate_flags; */
         uint32_t u32;
 
-        if (!input_buf || (input_len < 8) || memcmp(input_buf, "NTLMSSP", 8)) {
+        /* We unconditionally read the 64 byte fixed part of the
+         * AUTHENTICATE_MESSAGE below (up to and including the negotiate flags
+         * at offset 4*15), so insist on having all of it.
+         */
+        if (!input_buf || (input_len < 64) || memcmp(input_buf, "NTLMSSP", 8)) {
                 return -1;
         }
         memcpy(&u32, &input_buf[4*2], 4);
@@ -1243,7 +1287,7 @@ ntlmssp_authenticate_blob(struct smb2_server *server, struct smb2_context *smb2,
         /* if no user/pw, and anonymous allowed, do anonymous */
         if (!auth_data->user || (auth_data->user[0] == '\0') ||
                         !smb2->password || (smb2->password[0] == '\0')) {
-                if (server->allow_anonymous) {
+                if (server && server->allow_anonymous) {
                         return 0;
                 }
                 return -1;
@@ -1261,7 +1305,15 @@ ntlmssp_authenticate_blob(struct smb2_server *server, struct smb2_context *smb2,
         if (field_len == 0 || field_off == 0) {
                 return -1;
         }
-        if (field_off > (uint32_t)input_len) {
+        /* The response consists of a 16 byte NTProofStr followed by the
+         * client's "temp" blob. Both the offset and the length are attacker
+         * controlled, so verify the whole response lies inside the blob
+         * before we read any of it.
+         */
+        if (field_len < 16 ||
+            field_off > (uint32_t)input_len ||
+            field_len > (uint32_t)input_len - field_off) {
+                smb2_set_error(smb2, "NTLMSSP response field out of bounds");
                 return -1;
         }
         /* 16 byte NTLMv2 response */
@@ -1274,6 +1326,9 @@ ntlmssp_authenticate_blob(struct smb2_server *server, struct smb2_context *smb2,
                         free(auth_data->client_challenge);
                 }
                 auth_data->client_challenge = malloc(8);
+                if (auth_data->client_challenge == NULL) {
+                        return -1;
+                }
                 memcpy(auth_data->client_challenge, input_buf + field_off + 32, 8);
         }
         else {
diff --git a/lib/smb2-cmd-error.c b/lib/smb2-cmd-error.c
index de8d6b2..779e5c8 100644
--- a/lib/smb2-cmd-error.c
+++ b/lib/smb2-cmd-error.c
@@ -140,6 +140,17 @@ smb2_process_error_fixed(struct smb2_context *smb2,
         smb2_get_uint8(iov, 2, &rep->error_context_count);
         smb2_get_uint32(iov, 4, &rep->byte_count);
 
+        /* byte_count comes straight off the wire and is used as the size of
+         * the variable part, so make sure it stays within this PDU.
+         */
+        if ((uint64_t)SMB2_HEADER_SIZE + (SMB2_ERROR_REPLY_SIZE & 0xfffe) +
+            rep->byte_count > (uint64_t)smb2->spl) {
+                smb2_set_error(smb2, "Error data extends beyond end of PDU");
+                pdu->payload = NULL;
+                free(rep);
+                return -1;
+        }
+
         return rep->byte_count;
 }
 
diff --git a/lib/smb2-cmd-ioctl.c b/lib/smb2-cmd-ioctl.c
index f00f334..2fa6368 100644
--- a/lib/smb2-cmd-ioctl.c
+++ b/lib/smb2-cmd-ioctl.c
@@ -310,7 +310,8 @@ smb2_process_ioctl_variable(struct smb2_context *smb2,
         struct smb2_iovec vec;
         void *ptr;
 
-        if (rep->output_count > iov->len - IOV_OFFSET) {
+        if (IOV_OFFSET > iov->len ||
+            rep->output_count > iov->len - IOV_OFFSET) {
                 return -EINVAL;
         }
 
@@ -321,6 +322,9 @@ smb2_process_ioctl_variable(struct smb2_context *smb2,
         case SMB2_FSCTL_GET_REPARSE_POINT:
                 ptr = smb2_alloc_init(smb2,
                                       sizeof(struct smb2_reparse_data_buffer));
+                if (ptr == NULL) {
+                        return -ENOMEM;
+                }
                 if (smb2_decode_reparse_data_buffer(smb2, ptr, ptr, &vec)) {
                         smb2_set_error(smb2, "could not decode reparse "
                                        "data buffer. %s",
@@ -333,7 +337,14 @@ smb2_process_ioctl_variable(struct smb2_context *smb2,
                 if (ptr == NULL) {
                         return -ENOMEM;
                 }
-                memcpy(ptr, &iov->buf[IOV_OFFSET], iov->len - IOV_OFFSET);
+                /*
+                 * Only copy the output buffer. iov->len also covers the
+                 * padding and any input buffer that precedes it (see the
+                 * length smb2_process_ioctl_fixed() returned), so using it
+                 * as the copy length overruns the allocation whenever
+                 * input_count is non-zero.
+                 */
+                memcpy(ptr, &iov->buf[IOV_OFFSET], rep->output_count);
         }
 
         rep->output = ptr;
@@ -408,7 +419,8 @@ smb2_process_ioctl_request_variable(struct smb2_context *smb2,
         void *ptr = NULL;
         struct smb2_ioctl_validate_negotiate_info *info;
 
-        if (req->input_count > iov->len - IOVREQ_OFFSET) {
+        if (IOVREQ_OFFSET > iov->len ||
+            req->input_count > iov->len - IOVREQ_OFFSET) {
                 return -EINVAL;
         }
 
@@ -418,7 +430,15 @@ smb2_process_ioctl_request_variable(struct smb2_context *smb2,
         switch (req->ctl_code) {
         case SMB2_FSCTL_VALIDATE_NEGOTIATE_INFO:
                 /* this one is handled locally regardless of proxy or not */
+                if (vec.len < 24) {
+                        smb2_set_error(smb2, "Validate negotiate info request "
+                                       "is too short");
+                        return -EINVAL;
+                }
                 ptr = smb2_alloc_init(smb2, sizeof(struct smb2_ioctl_validate_negotiate_info));
+                if (ptr == NULL) {
+                        return -ENOMEM;
+                }
                 info = ptr;
                 smb2_get_uint32(&vec, 0, &info->capabilities);
                 memcpy(info->guid, &vec.buf[4], 16);
diff --git a/lib/smb2-cmd-negotiate.c b/lib/smb2-cmd-negotiate.c
index c4c6577..93fb735 100644
--- a/lib/smb2-cmd-negotiate.c
+++ b/lib/smb2-cmd-negotiate.c
@@ -213,7 +213,7 @@ smb2_encode_negotiate_reply(struct smb2_context *smb2,
                               struct smb2_negotiate_reply *rep)
 {
         uint8_t *buf;
-        int len, seclen;
+        int len, seclen = 0;
         struct smb2_iovec *iov;
 
         len = SMB2_NEGOTIATE_REPLY_SIZE & 0xfffe;
@@ -239,8 +239,11 @@ smb2_encode_negotiate_reply(struct smb2_context *smb2,
         }
 
         if (rep->security_buffer_length) {
-                seclen = rep->security_buffer_length;
-                seclen = PAD_TO_64BIT(len);
+                /* The buffer has to be sized from the security buffer we are
+                 * about to copy into it, not from the size of the fixed part
+                 * of the reply.
+                 */
+                seclen = PAD_TO_64BIT(rep->security_buffer_length);
                 /* Security buffer */
                 buf = malloc(seclen);
                 if (buf == NULL) {
@@ -339,12 +342,19 @@ smb2_parse_negotiate_contexts(struct smb2_context *smb2,
         uint16_t type, len;
 
         while (count--) {
-                if (offset > (int)iov->len) {
-                        smb2_set_error(smb2, "Bad len in negotiate context\n");
+                /* the 8 byte context header must be present, and the context
+                 * data it describes must fit in what is left of the buffer
+                 */
+                if (offset < 0 || (size_t)offset + 8 > iov->len) {
+                        smb2_set_error(smb2, "Bad offset in negotiate context");
                         return -1;
                 }
                 smb2_get_uint16(iov, offset, &type);
                 smb2_get_uint16(iov, offset + 2, &len);
+                if ((size_t)len > iov->len - offset - 8) {
+                        smb2_set_error(smb2, "Bad len in negotiate context");
+                        return -1;
+                }
 
                 switch (type) {
                 case SMB2_PREAUTH_INTEGRITY_CAP:
@@ -411,7 +421,8 @@ smb2_process_negotiate_fixed(struct smb2_context *smb2,
         smb2_get_uint16(iov, 58, &rep->security_buffer_length);
 
         if (rep->security_buffer_length &&
-            (rep->security_buffer_offset + rep->security_buffer_length > (uint16_t)smb2->spl)) {
+            ((uint32_t)rep->security_buffer_offset +
+             rep->security_buffer_length > smb2->spl)) {
                 smb2_set_error(smb2, "Security buffer extends beyond end of "
                                "PDU");
                 pdu->payload = NULL;
@@ -547,6 +558,11 @@ smb2_parse_netname_request_context(struct smb2_context *smb2,
 {
         char *client;
 
+        if (offset < 0 || len < 0 || (size_t)offset + (size_t)len > iov->len) {
+                smb2_set_error(smb2, "Netname context extends beyond the "
+                               "negotiate request");
+                return -1;
+        }
         client = discard_const(smb2_utf16_to_utf8((uint16_t *)(void *)(iov->buf + offset), len / 2));
         free(client);
         return 0;
@@ -561,10 +577,16 @@ smb2_parse_negotiate_request_contexts(struct smb2_context *smb2,
         uint16_t type, len;
 
         while (count--) {
+                /* the 8 byte context header must be present, and the context
+                 * data it describes must fit in what is left of the buffer
+                 */
+                if (offset < 0 || (size_t)offset + 8 > iov->len) {
+                        smb2_set_error(smb2, "Bad offset in negotiate context");
+                        return -1;
+                }
                 smb2_get_uint16(iov, offset, &type);
                 smb2_get_uint16(iov, offset + 2, &len);
-
-                if (offset > (int)iov->len) {
+                if ((size_t)len > iov->len - offset - 8) {
                         smb2_set_error(smb2, "Bad len in negotiate context");
                         return -1;
                 }
